    /usr/bin/rm -f /tmp/atlas-mount-[0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z]/etc/ssh/ssh_host_ed25519_key /tmp/atlas-mount-[0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z][0-9A-Za-z]/etc/ssh/ssh_host_ed25519_key.pub, \
