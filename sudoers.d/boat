# A copy-on-write snapshot inherits its origin's filesystem UUID, and two mounted
# filesystems claiming one UUID is a host-side blkid that lies — so a rebuild
# rerolls it. The LABEL is pinned and is kept rather than rerolled, because the
# guest mounts its data disk by label and the fstab line the identity injection
# writes says LABEL=atlas-data. e2fsck is unchecked in the code, like the Python:
# a restored data filesystem that needs a repair gets one, and "I fixed something"
# is not a failed rebuild.
Cmnd_Alias BOAT_VIRTUAL_MACHINE_FILESYSTEM = \
    /usr/sbin/tune2fs -U random -L atlas-root /dev/atlas/atlas-vm-*, \
