# --- Terminate: taking the VM tree off the host ----------------------------
# `disable --now` rather than `stop`, because the unit must not come back on the
# next boot, and it is the stop inside it that runs ExecStopPost and unwinds the
# netns, veth and proxy-NDP.
#
# The rm -rf is the single most dangerous line in this file, and it is the second
# of the two that spell the UUID out character by character. `rm -rf
# /var/lib/atlas/virtual-machines/*` also matches
# `/var/lib/atlas/virtual-machines/x /etc` — a `*` matches spaces, so one wildcard
# turns a per-VM delete into an arbitrary one — and it also matches
# `.../../../..`, because a `*` matches `/` and `.` too. `?` is not enough either:
# it fixes the length at 36 but still matches a space, and a 36-character field
# has room for ` /root`. A character class matches neither a space nor a `/`, so
# this line can name exactly one directory, and only a directory whose name is the
# shape internal/paths.IsUUID accepts.
Cmnd_Alias BOAT_VIRTUAL_MACHINE_TERMINATE = \
    /usr/bin/systemctl disable --now firecracker-vm@[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].service, \
    /usr/bin/rm -rf /var/lib/atlas/virtual-machines/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]

